            0.74,
            0.14
          ],
          "content": [
            {
              "type": "text",
              "content": "Internal technical note, sample scanned document for document parsing"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.095,
            0.174,
            0.199,
            0.193
          ],
          "content": [
            {
              "type": "text",
              "content": "1. History"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.094,
            0.201,
            0.894,
            0.291
          ],
          "content": [
            {
              "type": "text",
              "content": "The first practical silicon solar cell was demonstrated in 1954 at Bell Labs by Daryl Chapin, Calvin Fuller and Gerald Pearson; it converted about 6% of sunlight into electricity. Early cells powered satellites such as Vanguard 1 (1958). In 1961 William Shockley and Hans-Joachim Queisser derived the detailed-balance limit for a single p-n junction, which is about 33.7% for a band gap of 1.34 eV under standard sunlight."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.097,
            0.304,
            0.291,
            0.322
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Device equations"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.097,
            0.336,
            0.389,
            0.354
          ],
          "content": [
            {
              "type": "text",
              "content": "2.1 Current-voltage characteristic"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.098,
            0.359,
            0.702,
            0.378
          ],
          "content": [
            {
              "type": "text",
              "content": "An illuminated solar cell is modelled as a current source in parallel with a diode:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.36,
            0.384,
            0.639,
            0.416
          ],
          "image_path": "images/page_0_equation_9.jpg",
          "content": "I = I _ {L} - I _ {0} \\Bigl [ \\exp \\left(\\frac {q V}{n k T}\\right) - 1 \\Bigr ]"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.099,
            0.422,
            0.43,
            0.439
          ],
          "content": [
            {
              "type": "text",
              "content": "Setting "
            },
            {
              "type": "equation_inline",
              "content": "I = 0"
            },
            {
              "type": "text",
              "content": " gives the open-circuit voltage:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 11,
          "bbox": [
            0.395,
            0.444,
            0.607,
            0.476
          ],
          "image_path": "images/page_0_equation_11.jpg",
          "content": "V _ {o c} = \\frac {n k T}{q} \\ln \\left(\\frac {I _ {L}}{I _ {0}} + 1\\right)"
        },
        {
          "type": "paragraph_title",
          "index": 12,
          "bbox": [
            0.1,
            0.49,
            0.224,
            0.508
          ],
          "content": [
            {
              "type": "text",
              "content": "2.2 Efficiency"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.1,
            0.513,
            0.64,
            0.532
          ],
          "content": [
            {
              "type": "text",
              "content": "The fill factor "
            },
            {
              "type": "equation_inline",
              "content": "FF"
            },
            {
              "type": "text",
              "content": " and the power conversion efficiency "
            },
            {
              "type": "equation_inline",
              "content": "\\eta"
            },
            {
              "type": "text",
              "content": " are defined as:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.349,
            0.537,
            0.652,
            0.57
          ],
          "image_path": "images/page_0_equation_14.jpg",
          "content": "F F = \\frac {P _ {m a x}}{V _ {o c} I _ {s c}}, \\quad \\eta = \\frac {F F \\cdot V _ {o c} \\cdot I _ {s c}}{P _ {i n}}"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.102,
            0.576,
            0.163,
            0.591
          ],
          "content": [
            {
              "type": "text",
              "content": "where:"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.096,
            0.596,
            0.734,
            0.618
          ],
          "content": [
            {
              "type": "text",
              "content": "- "
            },
            {
              "type": "equation_inline",
              "content": "I_{\\mathrm{L}}"
            },
            {
              "type": "text",
              "content": " — photogenerated current, approximately equal to the short-circuit current "
            },
            {
              "type": "equation_inline",
              "content": "I_{\\mathrm{sc}}"
            },
            {
              "type": "text",
              "content": ";"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.096,
            0.623,
            0.442,
            0.642
          ],
          "content": [
            {
              "type": "text",
              "content": "- "
            },
            {
              "type": "equation_inline",
              "content": "I_{0}"
            },
            {
              "type": "text",
              "content": " — dark saturation current of the diode;"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.097,
            0.646,
            0.641,
            0.663
          ],
          "content": [
            {
              "type": "text",
              "content": "- "
            },
            {
              "type": "equation_inline",
              "content": "n"
            },
            {
              "type": "text",
              "content": " — ideality factor; "
            },
            {
              "type": "equation_inline",
              "content": "k"
            },
            {
              "type": "text",
              "content": " — Boltzmann constant; "
            },
            {
              "type": "equation_inline",
              "content": "T"
            },
            {
              "type": "text",
              "content": " — cell temperature;"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.095,
            0.668,
            0.709,
            0.693
          ],
          "content": [
            {
              "type": "text",
              "content": "- "
            },
            {
              "type": "equation_inline",
              "content": "P_{\\text{in}}"
            },
            {
              "type": "text",
              "content": " — incident light power, 1000 W/m"
            },
            {
              "type": "equation_inline",
              "content": "^{2}"
            },
            {
